# LeadGuard Release 1 - environment (Section 35). Secrets live in the cloud secret manager in production.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Runtime connection as lg_app (NOBYPASSRLS). Never use the admin or lg_owner role here.
DATABASE_URL=postgres://lg_app:change-me@localhost:5432/leadguard
# Worker sweeper / outbox publisher as lg_scanner.
SCANNER_DATABASE_URL=postgres://lg_scanner:change-me@localhost:5432/leadguard
# CI deploy step only (migrations). Admin role able to create roles on first run.
MIGRATION_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/leadguard
LG_APP_PASSWORD=change-me
LG_SCANNER_PASSWORD=change-me

# BullMQ + rate-limit counters only. Losing Redis never loses a lead or alert decision.
REDIS_URL=redis://localhost:6379

# Authentication. AUTH_MODE=dev accepts "Bearer dev:<clerk_user_id>:<email>[:<name>]" and is refused in production.
AUTH_MODE=dev
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
SUPPORT_CLERK_PUBLISHABLE_KEY=
SUPPORT_CLERK_SECRET_KEY=

# Comma-separated base64 32-byte keys, newest first (AES-256-GCM for source secrets).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOURCE_SECRET_ENCRYPTION_KEYS=
# Signs pagination cursors (and export download URLs unless EXPORT_SIGNING_SECRET is set).
CURSOR_SECRET=

# Providers - BLOCKED until selected (Appendix E). Keep `none`.
EMAIL_PROVIDER=none
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=LeadGuard <alerts@leadguard.io>
BOT_CHALLENGE_PROVIDER=none
BOT_CHALLENGE_SECRET=
BILLING_PROVIDER=none
BILLING_WEBHOOK_SECRET=

# Export files (private storage; signed URLs 15 min; files deleted after 24 h).
EXPORT_BUCKET=leadguard-exports-dev
EXPORT_LOCAL_DIR=./.data/exports
EXPORT_PUBLIC_BASE_URL=http://localhost:3001
EXPORT_SIGNING_SECRET=

# Feature flags: call_sources, self_service_checkout, embed_sources, sms_alerts
FEATURE_FLAGS=call_sources:false,self_service_checkout:false,embed_sources:false,sms_alerts:false

# Plans and trial (OD-03 pending leadership approval). PLANS_JSON overrides the illustrative defaults.
TRIAL_DAYS=14
PLAN_PRICES_STATUS=draft
# PLANS_JSON=[{"plan_id":"team","name":"Team","price_monthly":null,"limits":{"members":10,"sources":3,"leads_per_month":1000}}]

LOG_LEVEL=info

# ---- Web app (apps/web) ----
# dev = development sign-in matching the API's AUTH_MODE=dev; clerk = Clerk (needs the keys below)
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Where Next proxies /api/v1 (server side). Leave NEXT_PUBLIC_API_URL empty to use the same-origin proxy.
NEXT_PUBLIC_API_URL=
